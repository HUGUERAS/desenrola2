# ─────────────────────────────────────────────
# Desenrola API — Variáveis de Ambiente
# Copie para .env e preencha com seus valores
# ─────────────────────────────────────────────

# Ambiente
ENV=development
DEBUG=False

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (pode ser o JWT Secret do Supabase)
SUPABASE_JWT_SECRET=seu-jwt-secret-aqui

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Geometria / Validação
SRID=4674
AREA_MIN_M2=100
GAP_TOLERANCE_M2=1

# Servidor
HOST=0.0.0.0
PORT=8010
